# What Vercel does NOT need. The static front end is three files —
# templates/index.html, static/logo.png and deploy/vercel-build.sh — and
# everything below is either backend-only, secret, or dead weight.

# Secrets. The backend container holds the key; the static host never sees it.
.env
*.env

# The entire analysis backend. Excluded on purpose, not by accident: it cannot
# run on Vercel (torch alone is ~800 MB against a 250 MB function cap) and
# leaving *.py out of the upload also stops Vercel from trying to detect a
# Python runtime for a deployment that is pure static output.
*.py
requirements.txt
Dockerfile
.dockerignore

# Backend-only assets
original_index.html

# Local virtualenvs — huge, and Windows-built
.venv/
.venv311/
venv/
env/

# Python and editor noise
__pycache__/
*.py[cod]
*.egg-info/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Model weights, if any ever land in-tree
models/
*.bin
*.pt
*.safetensors

# Knowledge graph — a dev tool
graphify-out/

# Build output, regenerated by deploy/vercel-build.sh on every deploy
public/
